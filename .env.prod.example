# Production secrets/config for docker-compose.prod.yml.
#
# Copy to .env.prod (git-ignored) and fill in, or just run
# scripts/generate-prod-secrets.sh, which does this for you. ALWAYS pass this
# file explicitly: `docker compose -f docker-compose.prod.yml --env-file
# .env.prod <command>` -- it is deliberately NOT named plain ".env" so it can
# never be auto-loaded by the unrelated dev docker-compose.yml sitting next to
# it.
#
# chmod 600 this file once it holds real secrets.

# ---------------------------------------------------------------------------
# Public address (see infrastructure/caddy/Caddyfile)
# ---------------------------------------------------------------------------
# No domain yet: use the VPS's bare IP. Caddy issues an automatic self-signed
# cert for it (`tls internal`) -- satisfies the app's own HTTPS-URL production
# checks, but browsers will show an untrusted-certificate warning until a real
# domain replaces this (at which point also flip `tls internal` to
# `tls you@example.com` in the Caddyfile).
PUBLIC_HOST=179.197.227.244
PUBLIC_ORIGIN=https://179.197.227.244

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=ldcn
POSTGRES_PASSWORD=
POSTGRES_DB=ldcn_os

# ---------------------------------------------------------------------------
# MinIO (S3-compatible artifact storage)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=ldcn-artifacts
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=ldcn-artifacts

# ---------------------------------------------------------------------------
# LDCN API secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# ---------------------------------------------------------------------------
LDCN_SECRET_KEY=
# Must be DIFFERENT from LDCN_SECRET_KEY -- rotated independently.
LDCN_TOKEN_ENC_KEY=
# Minimum 32 characters.
LDCN_METRICS_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Capacity tuning for this VPS (2 vCPU / 8 GB) -- keep both low; the sandbox
# workload containers and Postgres/Redis/MinIO all share the same box.
# ---------------------------------------------------------------------------
LDCN_MAX_CONCURRENT_GENERATIONS=1
LDCN_AGENT_WORKERS=2
