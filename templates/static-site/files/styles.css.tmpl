:root { font-family: Inter, system-ui, sans-serif; background: #fbfaf7; color: #1d2320; }
body { margin: 0; }
main { min-height: 100vh; padding: 80px 8vw; }
p:first-child { color: #68604d; text-transform: uppercase; letter-spacing: .16em; font-size: 12px; font-weight: 700; }
h1 { max-width: 980px; font-size: clamp(42px, 8vw, 94px); line-height: .95; letter-spacing: 0; }
section { max-width: 720px; margin-top: 48px; border-top: 1px solid #ded8cb; padding-top: 24px; }
section p { color: #555; line-height: 1.7; }
