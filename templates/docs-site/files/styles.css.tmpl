:root { font-family: Inter, system-ui, sans-serif; color: #202124; background: #f8f9fb; }
body { display: grid; grid-template-columns: 260px 1fr; min-height: 100vh; margin: 0; }
aside { padding: 28px; border-right: 1px solid #dde1e7; background: #fff; position: sticky; top: 0; height: 100vh; }
aside strong { display: block; margin-bottom: 24px; }
aside a { display: block; color: #4a5968; text-decoration: none; margin: 12px 0; }
main { padding: 64px 8vw; max-width: 980px; }
.eyebrow { text-transform: uppercase; letter-spacing: .16em; color: #315f72; font-size: 12px; font-weight: 700; }
h1 { font-size: clamp(38px, 7vw, 76px); line-height: 1; letter-spacing: 0; }
section { margin-bottom: 56px; }
pre { white-space: pre-wrap; border: 1px solid #dde1e7; border-radius: 8px; padding: 18px; background: #fff; }
@media (max-width: 760px) { body { grid-template-columns: 1fr; } aside { position: static; height: auto; } }
