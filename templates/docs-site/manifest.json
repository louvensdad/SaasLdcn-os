{
  "id": "docs-site",
  "name": "Documentation Static Site",
  "description": "Deterministic documentation site foundation with static HTML.",
  "runtime": "local_static_v0",
  "supported_locales": ["pt-BR", "en-US", "es-ES", "fr-FR"],
  "fallback_locale": "en-US",
  "metadata": {
    "framework": "vanilla",
    "mode": "static",
    "no_ai": true,
    "no_agents": true
  },
  "variables_schema": {
    "project.name": "string",
    "project.locale": "string"
  },
  "supported_capabilities": ["seo", "search", "i18n"]
}
