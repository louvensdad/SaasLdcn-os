# Forces path-style S3 addressing for MinIO. artifact_storage.py's
# boto3.client("s3", endpoint_url=..., region_name=...) call takes no
# addressing-style override, and there is no environment variable for it --
# this shared AWS config file (auto-discovered by boto3 at ~/.aws/config) is
# the only way to set it without touching app code. Not secret; credentials
# are passed via AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env vars instead (see
# docker-compose.prod.yml), so this file is safe to commit.
[default]
region = us-east-1
s3 =
    addressing_style = path
