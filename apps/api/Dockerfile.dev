# Dev-only image -- NEVER build or ship this for production, use Dockerfile
# instead. Adds Node.js + Playwright/Chromium on top of the same base as the
# production image so the Runtime Functional Test (host-execution-only, off by
# default: needs EXECUTION_RUNTIME=host and ALLOW_HOST_EXECUTION=true set
# explicitly at runtime) can start a generated Next.js frontend and drive a
# real headless browser against it. See runtime_functional_test_service.py.
# slim-bookworm, not the floating slim tag: Playwright's --with-deps installer
# ships a fixed list of supported distros per release and doesn't yet
# recognize Debian trixie (what plain "slim" now resolves to) -- it falls back
# to an Ubuntu 20.04 package list with renamed/missing font packages there.
FROM python:3.12-slim-bookworm AS dev

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN groupadd --gid 10001 ldcn \
    && useradd --uid 10001 --gid ldcn --create-home ldcn

# Node.js 22 (matches apps/web/Dockerfile) -- generated Next.js frontends need
# npm install / npm run dev.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# /workspace/apps/api, not a flat /app: app/core/config.py derives
# WORKSPACE_ROOT as two directories above BASE_DIR (BASE_DIR.parents[1]) to
# reach the monorepo root (where generated-projects/ lives, and where a
# generated project's own venv/npm install/dev servers actually run under
# Runtime Functional Test) -- matches apps/web/Dockerfile's own
# /workspace/apps/web convention. A flat /app collapses that arithmetic
# (parents[1] doesn't exist) and crashes on import.
WORKDIR /workspace/apps/api
COPY requirements.txt requirements-dev.txt ./
RUN pip install --requirement requirements-dev.txt

# Chromium + its OS-level rendering deps (fonts, libnss3, ...); --with-deps
# pulls those in via apt instead of guessing the package list by hand.
# PLAYWRIGHT_BROWSERS_PATH above keeps the download out of a per-user home
# directory, so it stays reachable after USER drops to uid 10001 below.
RUN python -m playwright install --with-deps chromium \
    && chown -R 10001:10001 /ms-playwright

COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app

# The app creates generated-projects/ (repo-root-relative) and app/data/
# subpaths (sqlite db, execution evidence, ...) at runtime -- without this,
# everything stays root-owned and uid 10001 can't create them.
RUN mkdir -p /workspace/generated-projects && chown -R 10001:10001 /workspace

USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=3)"]
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
