# Copy to apps/api/.env and fill in. The .env file is git-ignored.
# config.py loads this automatically (via python-dotenv) before reading settings.
# Real environment variables always take precedence over values set here.



# LDCN Sandbox Execution Runtime (mandatory for every generated/imported project command).
EXECUTION_RUNTIME=sandbox
ALLOW_HOST_EXECUTION=false
LDCN_SANDBOX_CONTAINER_CLI=docker
LDCN_SANDBOX_IMAGE=ldcn/sandbox-runtime:2026.07
LDCN_SANDBOX_TIMEOUT_SECONDS=300
LDCN_SANDBOX_MEMORY_MB=2048
LDCN_SANDBOX_CPU_CORES=1
LDCN_SANDBOX_DISK_MB=1024
LDCN_SANDBOX_PIDS=128
LDCN_SANDBOX_OUTPUT_BYTES=2097152
LDCN_SANDBOX_GENERATED_FILE_BYTES=268435456
LDCN_SANDBOX_OPEN_FILES=1024
# Required for dependency installs and HTTPS Git clones. This Docker network must
# be internal; its only egress is the allowlist proxy.
LDCN_SANDBOX_EGRESS_NETWORK=ldcn-sandbox-egress
LDCN_SANDBOX_EGRESS_PROXY=http://egress-proxy:3128
LDCN_SANDBOX_EGRESS_PROXY_CONTAINER=ldcn-sandbox-egress-proxy

# Primary database. SQLite remains the zero-setup local default; PostgreSQL is
# required for multi-instance production deployments.
# Local default: sqlite:///C:/absolute/path/to/apps/api/app/data/ldcn_os.db
# LDCN_DATABASE_URL=postgresql://ldcn:change-me@localhost:5432/ldcn_os
# Apply schema before starting the API: alembic upgrade head
# Stable secret used to sign JWT access/refresh tokens and to derive the
# at-rest encryption key for stored provider credentials.
#
# REQUIRED in production (LDCN_ENVIRONMENT=production). In local dev, if unset,
# an ephemeral key is generated per process â€” which invalidates all existing
# sessions on every restart. Set a stable value to avoid surprise 401s.
#
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
LDCN_SECRET_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
LDCN_TOKEN_ENC_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Optional. Defaults to "local"; set to "production" in deployed environments.
# LDCN_ENVIRONMENT=local

# Optional. Comma-separated CORS origins (defaults cover localhost dev ports).
# LDCN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Then pick a "Local Â· â€¦" model in the Meta-Factory UI. Override the endpoint if

# Alternatively set a server-wide key here, and/or override the endpoint.

# the key is optional (per-user "custom" key in the UI, this env var, or none).

# Shared Redis for distributed rate limiting and the user-key vault.
# Required for multi-instance production deployments.
# LDCN_REDIS_URL=redis://localhost:6379/0

# Optional. Google/GitHub social login ("Continue with Google/GitHub" on the
# login page). Unset by default: without credentials, those buttons redirect
# back with a graceful error instead of starting a flow.
#
# 1. Google: https://console.cloud.google.com/apis/credentials -> Create
#    Credentials -> OAuth client ID -> Web application. Add this Authorized
#    redirect URI (replace with this API's real public base URL in prod):
#      http://localhost:8000/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# 2. GitHub: https://github.com/settings/developers -> New OAuth App.
#    Authorization callback URL:
#      http://localhost:8000/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
#
# Where the browser is sent back to after the OAuth round trip. Must be the
# frontend's real base URL (defaults to the Next.js dev server).
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Modernize ingest quotas and approved Git providers
LDCN_MODERNIZE_MAX_UPLOAD_BYTES=268435456
LDCN_MODERNIZE_MAX_ANALYZABLE_BYTES=268435456
LDCN_MODERNIZE_MAX_FILE_BYTES=5242880
LDCN_MODERNIZE_MAX_ARCHIVE_ENTRIES=200000
LDCN_MODERNIZE_MAX_ARCHIVE_UNCOMPRESSED_BYTES=1073741824
LDCN_MODERNIZE_MAX_ARCHIVE_DEPTH=32
LDCN_MODERNIZE_MAX_ARCHIVE_NAME_BYTES=1024
LDCN_MODERNIZE_ARCHIVE_SCAN_TIMEOUT_SECONDS=15
LDCN_MODERNIZE_ZIP_BOMB_RATIO=100
LDCN_MODERNIZE_GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
# Durable generation leases and token budgets
LDCN_GENERATION_JOB_LEASE_SECONDS=1800
LDCN_GENERATION_JOB_TOKEN_BUDGET=800000
LDCN_GENERATION_DAILY_TOKEN_BUDGET=2000000
# Dedicated Prometheus scraper credential (minimum 32 characters in production)
LDCN_METRICS_BEARER_TOKEN=
