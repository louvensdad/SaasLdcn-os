# Copy to apps/api/.env and fill in. The .env file is git-ignored.
# config.py loads this automatically (via python-dotenv) before reading settings.
# Real environment variables always take precedence over values set here.

# Stable secret used to sign JWT access/refresh tokens and to derive the
# at-rest encryption key for stored provider credentials.
#
# REQUIRED in production (LDCN_ENVIRONMENT=production). In local dev, if unset,
# an ephemeral key is generated per process — which invalidates all existing
# sessions on every restart. Set a stable value to avoid surprise 401s.
#
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
LDCN_SECRET_KEY=

# Optional. Defaults to "local"; set to "production" in deployed environments.
# LDCN_ENVIRONMENT=local

# Optional. Comma-separated CORS origins (defaults cover localhost dev ports).
# LDCN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. Local, key-free generation via Ollama (the "no API key" path).
# Install Ollama, run `ollama serve`, and pull a coder model, e.g.:
#   ollama pull qwen2.5-coder:7b
# Then pick a "Local · …" model in the Meta-Factory UI. Override the endpoint if
# Ollama runs elsewhere (default below).
# LDCN_OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional. Online generation via OpenRouter (one key, many models incl. free).
# Preferred: each user adds their own key in the UI ("Use my own key" -> OpenRouter).
# Alternatively set a server-wide key here, and/or override the endpoint.
# OPENROUTER_API_KEY=sk-or-...
# LDCN_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional. Any OpenAI-compatible endpoint (vLLM, LM Studio, Together, Groq, ...).
# Pick the "Custom (OpenAI-compat)" model in the UI. Base URL + model id are required;
# the key is optional (per-user "custom" key in the UI, this env var, or none).
# LDCN_CUSTOM_BASE_URL=http://localhost:8000/v1
# LDCN_CUSTOM_MODEL=my-model-name
# LDCN_CUSTOM_API_KEY=
