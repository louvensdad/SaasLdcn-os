{
  "name": "@ldcn/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-bundle-budget.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings 39",
    "typecheck": "tsc --noEmit",
    "audit:i18n": "node scripts/audit-hardcoded-i18n.mjs",
