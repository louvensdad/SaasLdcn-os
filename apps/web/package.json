    "audit:typography": "node scripts/audit-typography.mjs",
    "audit:typography:check": "node scripts/audit-typography.mjs --check",
    "audit:locales:check": "node scripts/check-locale-parity.mjs",
    "audit:hotspots:check": "node scripts/check-hotspot-budgets.mjs",
    "audit:typography:report": "node scripts/audit-typography.mjs --report",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:responsive-visibility": "playwright test -c playwright.responsive-visibility.config.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tanstack/react-query": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.500.0",
    "next": "15.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.18",
    "postcss": "^8.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0"
  },
